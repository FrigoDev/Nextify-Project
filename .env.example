# Spotify OAuth app credentials (Spotify Developer Dashboard → your app → Settings)
SPOTIFY_PUBLIC_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Base URL of the app, used for OAuth redirects.
# Local dev must use the loopback IP (Spotify no longer allows http://localhost).
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000
NEXTAUTH_URL=http://127.0.0.1:3000

# NextAuth JWT/session secret. Generate one with: openssl rand -base64 32
SECRET=your-nextauth-secret
